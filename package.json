{
  "name": "@sidequest-007/dsh-atlas",
  "description": "@ Last, All Sources. One @, every source; one click, the session it names.",
  "version": "1.0.2",
  "license": "MIT",
  "author": "Side Quest Labs",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "mention",
    "at-mention",
    "composer",
    "workspace",
    "reference"
  ],
  "homepage": "https://github.com/jameswatt139240-crypto/dsh-ATLAS#readme",
  "bugs": {
    "url": "https://github.com/jameswatt139240-crypto/dsh-ATLAS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameswatt139240-crypto/dsh-ATLAS.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.6-alpha.1"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types",
    "assets/screenshots",
    "assets/diagrams",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-ORIGINAL",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:ads": "node build.mjs --ads",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:publish": "node scripts/verify-publish-surface.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify:publish",
    "prepublishOnly": "pnpm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
